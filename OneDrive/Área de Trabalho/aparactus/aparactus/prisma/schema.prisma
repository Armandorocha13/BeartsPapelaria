// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Relação: 1 Barbershop possui vários BarbershopService (1:N)
// Ou seja, uma barbearia pode ter vários serviços associados.
// Por outro lado, cada BarbershopService está vinculado apenas a uma Barbershop (barbershopId é único).
model Barbershop {
  id          String              @id @default(uuid())
  name        String
  address     String
  description String
  imageUrl    String
  phones      String[]
  services    BarbershopService[] // Relacionamento 1:N com BarbershopService
}

// Cada serviço pertence a exatamente uma barbearia.
// Uma barbearia pode ter vários serviços (relação 1:N).
model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  priceInCents Int
  imageUrl     String
  barbershopId String     // FK para Barbershop
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade) // Relacionamento para Barbershop
}
